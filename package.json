{
  "name": "ink-cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node_modules/.bin/next dev --hostname 127.0.0.1 --port 3000",
    "build": "node_modules/.bin/next build",
    "build:worker": "node_modules/.bin/opennextjs-cloudflare build",
    "preview": "node_modules/.bin/wrangler dev",
    "deploy": "node_modules/.bin/opennextjs-cloudflare build && node_modules/.bin/wrangler deploy"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "marked": "^18.0.7",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.115.0"
  }
}
